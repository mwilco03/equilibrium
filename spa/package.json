{
  "name": "equilibrium-spa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:index && pnpm run build:data && tsc -b && vite build",
    "build:index": "node scripts/build-search-index.mjs",
    "build:data": "node scripts/copy-techniques.mjs",
    "preview": "vite preview",
    "validate": "ajv validate --spec=draft2020 -c ajv-formats -s ../schema/equilibrium.schema.json -d '../data/techniques/*.json' --strict=false",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.0.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
